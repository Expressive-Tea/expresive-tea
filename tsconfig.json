{
  "compilerOptions": {
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es2017",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictNullChecks": true,
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "baseUrl": ".",
    "declaration": true,
    "skipLibCheck": true,
    "lib": [
      "es2017",
      "dom"
    ],
    "paths": {
      "@classes": ["classes"],
      "@classes/*": ["classes/*"],
      "@decorators": ["decorators"],
      "@decorators/*": ["decorators/*"],
      "@engines": ["engines"],
      "@engines/*": ["engines/*"],
      "@exceptions": ["exceptions"],
      "@exceptions/*": ["exceptions/*"],
      "@helpers": ["helpers"],
      "@helpers/*": ["helpers/*"],
      "@interfaces": ["interfaces"],
      "@interfaces/*": ["interfaces/*"],
      "@libs": ["libs"],
      "@libs/*": ["libs/*"],
      "@services": ["services"],
      "@services/*": ["services/*"],
      "@types": ["types"],
      "@types/*": ["types/*"],
      "@mixins": ["mixins"],
      "@mixins/*": ["mixins/*"],
      "@config": ["config"],
      "@config/*": ["config/*"]
    }
  },
  "exclude": [
    "node_modules",
    "__test__",
    "benchmark"
  ]
}