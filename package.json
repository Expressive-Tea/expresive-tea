{
  "name": "@expressive-tea/core",
  "version": "2.0.1",
  "description": "A modern TypeScript-first framework for building scalable Node.js applications with clean architecture, dependency injection, and decorator-driven development",
  "main": "classes/Boot.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "yarn linter && vitest run --coverage",
    "test:clear": "rm -rf .vitest-cache",
    "test:ci": "yarn linter:ci && vitest run --coverage --reporter=verbose",
    "test:dev": "yarn linter && vitest",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "linter": "eslint . --fix",
    "linter:ci": "eslint .",
    "build:dev": "tsc --project tsconfig.json --watch",
    "build": "tsc --project tsconfig.json && resolve-tspaths --src . --out .",
    "clean:build": "trash '**/*.js' '**/*.d.ts' '**/*.js.map' '**/*.d.ts.map' '!node_modules/**/*' '!docs/**/*' '!coverage/**/*' '!gulpfile.js' '!tasks/*.js' '!jest.config.js' '!tools/**/*'",
    "publish:prepare": "npm run clean:build && npm run build",
    "postpublish": "npm run clean:build",
    "prepublishOnly": "npm test && npm run publish:prepare"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Diego Resendez <diego.resendez@zero-oneit.com>"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/eslintrc": "3.3.4",
    "@eslint/js": "9.39.1",
    "@expressive-tea/commons": "2026.1.1",
    "@expressive-tea/plugin": "2026.1.1",
    "@types/express": "5.0.6",
    "@types/express-http-proxy": "1.6.7",
    "@types/express-serve-static-core": "5.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "25.3.3",
    "@types/supertest": "7.2.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.7.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-promise": "7.2.1",
    "globals": "16.5.0",
    "http-terminator": "3.2.0",
    "jest-express": "^1.12.0",
    "prettier": "^3.8.1",
    "reflect-metadata": "0.2.2",
    "resolve-tspaths": "0.8.23",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "toast-jsdoc": "1.0.2",
    "trash-cli": "7.2.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "express-http-proxy": "2.1.2",
    "inversify": "7.11.0",
    "inversify-inject-decorators": "3.1.0",
    "js-yaml": "^4.1.0",
    "lodash": "4.17.23",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "url-scheme": "1.0.5",
    "winston": "^3.19.0",
    "ws": "8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Expressive-Tea/expresive-tea.git"
  },
  "keywords": [
    "typescript",
    "typescript-framework",
    "express",
    "express-typescript",
    "decorators",
    "dependency-injection",
    "inversify",
    "rest-api",
    "api-framework",
    "backend-framework",
    "nodejs-framework",
    "mvc-framework",
    "clean-architecture",
    "type-safe",
    "server-framework",
    "microservices",
    "websocket",
    "socket.io",
    "health-checks",
    "middleware",
    "controllers",
    "routing",
    "ioc-container",
    "modern-backend"
  ],
  "bugs": {
    "url": "https://github.com/Expressive-Tea/expresive-tea/issues"
  },
  "homepage": "https://github.com/Expressive-Tea/expresive-tea#readme",
  "optionalDependencies": {
    "bufferutil": "4.1.0",
    "utf-8-validate": "6.0.6"
  },
  "resolutions": {
    "set-value": "4.1.0",
    "glob-parent": "6.0.2",
    "engine.io": "6.4.2",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "9.39.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.2.1"
  },
  "packageManager": "yarn@4.11.0"
}
