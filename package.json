{
  "name": "@zerooneit/expressive-tea",
  "version": "1.3.0-beta.6",
  "description": "A REST API  over Express and Typescript",
  "main": "classes/Boot.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "npm run linter && jest --clearCache && jest --coverage  --ci --detectOpenHandles --forceExit --silent",
    "test:dev": "npm run linter && jest --clearCache && jest --detectOpenHandles --forceExit",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "linter": "eslint --ext .ts . --fix",
    "linter:ci": "eslint --ext .ts",
    "build:dev": "tsc --project tsconfig.json --watch",
    "build": "tsc --project tsconfig.json",
    "clean:build": "trash '**/*.js' '**/*.d.ts' '**/*.js.map' '**/*.d.ts.map' '!node_modules/**/*' '!docs/**/*' '!coverage/**/*' '!gulpfile.js' '!tasks/*.js' '!jest.config.js' '!tools/**/*'",
    "publish:prepare": "npm run clean:build && npm run build",
    "postpublish": "npm run clean:build",
    "prepublishOnly": "npm test && npm run publish:prepare"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Diego Resendez <diego.resendez@zero-oneit.com>"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@expressive-tea/commons": "^1.0.1",
    "@expressive-tea/plugin": "1.0.3",
    "@types/express": "4.17.21",
    "@types/express-http-proxy": "1.6.6",
    "@types/express-serve-static-core": "4.19.0",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.17.0",
    "@types/node": "20.12.7",
    "@types/reflect-metadata": "0.1.0",
    "@types/socket.io": "3.0.2",
    "@types/socket.io-client": "3.0.0",
    "@types/ws": "8.5.10",
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "eslint": "8.57.0",
    "eslint-config-love": "^47.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jsdoc": "^48.2.3",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "http-terminator": "3.2.0",
    "jest": "29.7.0",
    "jest-express": "1.12.0",
    "jest-junit": "16.0.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "5.0.5",
    "supertest": "6.3.4",
    "toast-jsdoc": "1.0.2",
    "trash-cli": "5.0.0",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "tslib": "^2.6.2",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "express": "4.22.0",
    "express-http-proxy": "2.0.0",
    "inversify": "6.0.2",
    "inversify-inject-decorators": "3.1.0",
    "lodash": "4.17.21",
    "socket.io": "4.7.5",
    "socket.io-client": "4.7.5",
    "url-scheme": "1.0.5",
    "ws": "8.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zero-OneiT/expresive-tea.git"
  },
  "keywords": [
    "Typescript",
    "typescript",
    "Express",
    "Decorators",
    "decorators",
    "decorator",
    "controller",
    "inject",
    "ioc",
    "di",
    "mvc",
    "es6",
    "es2015",
    "REST",
    "API",
    "express",
    "webserver",
    "route",
    "router",
    "express-ts",
    "restful",
    "server",
    "middleware",
    "controllers",
    "web",
    "service",
    "backend",
    "services",
    "node",
    "nodejs"
  ],
  "bugs": {
    "url": "https://github.com/Expressive-Tea/expresive-tea/issues"
  },
  "homepage": "https://github.com/Expressive-Tea/expresive-tea#readme",
  "optionalDependencies": {
    "bufferutil": "4.0.8",
    "utf-8-validate": "^6.0.0"
  },
  "resolutions": {
    "set-value": "4.1.0",
    "glob-parent": "6.0.2",
    "engine.io": "6.4.2",
    "@typescript-eslint/eslint-plugin": "7.7.0"
  },
  "packageManager": "yarn@4.1.1"
}
