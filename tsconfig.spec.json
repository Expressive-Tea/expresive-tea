{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "paths": {
      "@classes": ["classes"],
      "@classes/*": ["classes/*"],
      "@decorators": ["decorators"],
      "@decorators/*": ["decorators/*"],
      "@engines": ["engines"],
      "@engines/*": ["engines/*"],
      "@exceptions": ["exceptions"],
      "@exceptions/*": ["exceptions/*"],
      "@helpers": ["helpers"],
      "@helpers/*": ["helpers/*"],
      "@interfaces": ["interfaces"],
      "@interfaces/*": ["interfaces/*"],
      "@libs": ["libs"],
      "@libs/*": ["libs/*"],
      "@services": ["services"],
      "@services/*": ["services/*"],
      "@types": ["types"],
      "@types/*": ["types/*"],
      "@mixins": ["mixins"],
      "@mixins/*": ["mixins/*"],
      "@config": ["config"],
      "@config/*": ["config/*"],
      "@test-mocks": ["__test__/__mocks__"],
      "@test-mocks/*": ["__test__/__mocks__/*"],
      "@test-classes": ["__test__/test-classes"],
      "@test-classes/*": ["__test__/test-classes/*"],
      "@test-helpers": ["__test__/integrations/helpers"],
      "@test-helpers/*": ["__test__/integrations/helpers/*"]
    }
  },
  "include": ["__test__/**/*"]
}
